#  Directory backend API URL (to run locally, set it to http://localhost:3000)
DIRECTORY_API_URL=

# Auth API URL (to run locally, set it to https://sandbox-auth.plnetwork.io)
AUTH_API_URL=

# For PRIVY_AUTH_ID, register in Privy(https://www.privy.io/) and create a new project to get the API Key.
# For local development, set it to cm32ykwe203lh146v10gbdlnn
PRIVY_AUTH_ID=

# Set the domain for the cookie. For local development, set it to localhost
COOKIE_DOMAIN=

# Application Base URL (This will be the URL of the current application, For local development, set it to http://localhost:4200)
APPLICATION_BASE_URL=

# HUSKY AI Backend API URL (to run locally, set it to https://sandbox-husky.plnetwork.io) 
HUSKY_API_URL=

# PROTOSPHERE URL (to run locally, set it to https://protosphere.plnetwork.io)
PROTOSPHERE_URL=

# Support URL (to run locally, set it to https://www.plnetwork.io/contact?showModal=getSupport)
GET_SUPPORT_URL=

# For analytics purpose, Create an account in PostHog and get the API Key (Optional)
POSTHOG_KEY=
POSTHOG_HOST=

# Filter the homepage featured section based on selected criteria (e.g., location, event, member, team, or project)
# Example: location:<location name>|event:<event name>|team:<team name> 
PRIORITY_FEATURED_SECTION=

# Pl-events website url
NEXT_PUBLIC_PL_EVENTS_URL=

# Botpress Activity Assistant webchat (alignment-asset pages only)
NEXT_PUBLIC_BOTPRESS_WEBCHAT_ENABLED=

# In-app apply on the job board (sign-up banner, apply slot, profile drawer,
# apply modal). Set to 'true' on dev only — applications are still mocked
# client-side and reach no hiring team. Anything else, including unset, is off.
# Inlined at build time: a change needs a redeploy, not just a restart.
NEXT_PUBLIC_SHOW_JOB_BOARD_APPLY=

# Import experience from a CV inside the job profile drawer. Nested inside the
# flag above — the drawer only opens when that one is on. Keep unset until
# /v1/members/{uid}/cv-import/{parse,apply} exist, or the door 404s.
NEXT_PUBLIC_SHOW_CV_IMPORT=

#PLAA backend API URL
PLAA_API_URL=

# AI prototypes at /prototypes — enabled in development by default; set to true/false to override
PROTOTYPES_ENABLED=

# (optional, local dev only) set MOCK_TEAM_NEWS to 'true' to serve a rich fixture
# (multiple teams/focus areas/stories) for the homepage news feed instead of the
# real API — useful for testing the team-grouped UI when the API returns few items.
MOCK_TEAM_NEWS=

